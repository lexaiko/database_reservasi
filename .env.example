# ========================================================
# TripBanyuwangi Database & CRM Reservasi 2026 - Environment Configuration Example
# ========================================================

# 1. Google Sheets Database Configuration
# ID spreadsheet Google Sheets utama (dari URL /d/{ID}/edit)
GOOGLE_SHEETS_SPREADSHEET_ID=your_google_spreadsheet_id_here

# Nama tab sheets (opsional jika default)
# SHEET_RESERVASI=Database Reservasi
# SHEET_HPP=RincianHPP

# 2. Google Cloud Service Account (Server-Side Only)
# Salin seluruh isi file service-account.json sebagai satu baris JSON string
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"your-sa@your-project.iam.gserviceaccount.com"}

# 3. Vercel Cron Secret (Server-Side Only)
# Digunakan untuk otentikasi cron sync status trip di /api/cron/sync-status
CRON_SECRET=your_random_secret_token_for_cron

# 4. Firebase Configuration (Client & Auth SDK)
# Salin dari Firebase Console > Project Settings > General > Your Apps (Web App)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id
