*.tsbuildinfo
next-env.d.ts

# Vercel Deployment
.vercel

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

